# Generate a unique value; never reuse this example in a deployed environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Require login for application content when true. Auth/admin/static routes remain available.
DJANGO_PRIVATE_PORTAL=false

# Optional customer-facing branding for demos/pilots.
DJANGO_SITE_NAME=VideoShare
DJANGO_SITE_TAGLINE=A calmer place to watch, share, and organize video.
DJANGO_HOME_HEADLINE=Find your next favorite watch.
DJANGO_HOME_SUBTITLE=Fresh uploads, hidden gems, and ideas worth sharing—all in one calmer corner of the internet.

# Allow anonymous visitors to create accounts. Set false for closed/private pilots.
DJANGO_ALLOW_PUBLIC_REGISTRATION=true

# Local development only. Production should remain false.
DJANGO_DEBUG=true

# HTTP port used by the local container. Defaults to 8000 when omitted.
APP_PORT=8000
# Bind to loopback by default. Use 0.0.0.0 only when intentionally sharing on a trusted LAN.
APP_BIND_ADDRESS=127.0.0.1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=America/New_York

# Local/CI Django test worker count. Lower this on constrained machines.
DJANGO_TEST_PROCESSES=4

# Upload limits in megabytes.
DJANGO_MAX_VIDEO_UPLOAD_MB=500
DJANGO_MAX_THUMBNAIL_UPLOAD_MB=10

# Monetization platform share in basis points. 1000 = 10%.
MONETIZATION_PLATFORM_FEE_BPS=1000

# Payment provider. Keep "sandbox" for the built-in fake-money flows.
# Set to "stripe" only with Stripe TEST-MODE credentials.
MONETIZATION_PAYMENT_PROVIDER=sandbox
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# IMPORTANT: live Stripe secret keys (sk_live_...) are rejected by the app.
# For local webhook testing, use Stripe CLI to forward test events to the app
# and place the resulting whsec_... signing secret above.

# Media storage. Local filesystem storage remains the default.
DJANGO_USE_S3_MEDIA=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_QUERYSTRING_EXPIRE=3600
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Production HTTPS settings. Enable these after TLS is configured.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false


# Optional pilot-user setup/reset email delivery. Disabled by default.
DJANGO_PILOT_USER_SETUP_EMAIL_ENABLED=false

# Optional channel-team invitation email delivery.
# Disabled by default. The console backend lets you test locally with no provider/account.
DJANGO_TEAM_INVITATION_EMAIL_ENABLED=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@localhost
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
